# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── HTTPS (opcional — actívalo solo si Node termina TLS directamente)
# En producción se recomienda terminar TLS en el proxy (nginx/Caddy).
# Si HTTPS_ENABLED=true, debes proporcionar rutas absolutas a cert y key.
HTTPS_ENABLED=false
HTTPS_KEY_PATH=./certs/key.pem
HTTPS_CERT_PATH=./certs/cert.pem

# ─── CORS ────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3001


# ─── LLM ────────────────────────────────────────────────────────────────────
LLM_PROVIDER=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5.7b
LLM_API_KEY
